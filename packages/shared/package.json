      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/__tests__/"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "5.5.4"
  }
}
